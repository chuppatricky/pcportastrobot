new file mode 100644
index 0000000000..62c08c244d
--- /dev/null
+++ b/core/libs/prx/libc/include/ReadOnlyNameCache.hpp
@@ -0,0 +1,131 @@
+#ifndef CORE_LIBS_PRX_LIBC_INCLUDE_READONLYNAMECACHE_HPP
+#define CORE_LIBS_PRX_LIBC_INCLUDE_READONLYNAMECACHE_HPP
+
+#include <filesystem>
+#include <functional>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <set>
+#include <span>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+// Case-insensitive lookups in a tree whose contents do not change while the game runs (the game's
+// /app0), answered from one listing per directory.
+//
+// Wine matches every path component case-insensitively itself, by listing the directory whenever the
+// exact name is not there, so on a case-sensitive Linux file system each lookup of a missing name lists
+// its whole directory, once for every Win32 call made on that path. Astro Bot looks up thousands of
+// missing names in data/prein/*/odx (2,500-24,500 entries each) while a level loads: ~25 ms each, minutes
+// per level. With this cache a lookup is a map lookup; a name found resolves to its on-disk spelling (which
+// Wine then finds without listing), and a missing name resolves into an empty directory (where every
+// Win32 call on it misses at once and the callers report ENOENT as before).
+//
+// Internal to the file that includes it (libc's General.cpp): libc.prx exports every symbol with external
+// linkage, and this class adds none.
+namespace {
+
+class ReadOnlyNameCache {
+public:
+    struct Entry {
+        std::string name;              // as the resolver compares names (UTF-8)
+        std::filesystem::path native;  // as listed, appended to the directory's host path
+    };
+    // Lists a directory: nullopt when it cannot be listed (not a directory, an error).
+    using Lister = std::function<std::optional<std::vector<Entry>>(const std::filesystem::path& directory)>;
+
+    explicit ReadOnlyNameCache(Lister lister) : _lister(std::move(lister)) {}
+
+    // ASCII case folding, as the resolver's SameName.
+    static std::string Fold(std::string_view name) {
+        std::string folded(name);
+        for (auto& c : folded) if (c >= 'A' && c <= 'Z') c = static_cast<char>(c + ('a' - 'A'));
+        return folded;
+    }
+
+    // Names that can be matched here exactly as the resolver (ASCII folding) and Wine would match them;
+    // anything else (empty, ".", "..", non-ASCII, characters Win32 reads specially) resolves the usual way.
+    static bool Plain(std::string_view name) {
+        if (name.empty() || name == "." || name == ".." || name.back() == '.' || name.back() == ' ') return false;
+        for (const unsigned char c : name) {
+            if (c < 0x20 || c >= 0x7f) return false;
+            if (c == '*' || c == '?' || c == '<' || c == '>' || c == '|' || c == '"' || c == ':' || c == '\\' || c == '/') return false;
+        }
+        return true;
+    }
+
+    // root/relative[0]/relative[1]/... with each name in its on-disk spelling, or, from the first name that is
+    // not there, absent/<that name>/<the rest>. nullopt: resolve this path the usual way (a name this cache does
+    // not match, a directory that cannot be listed, two entries differing only in case).
+    //
+    // moduleSuffix (module lookups: sceKernelStat, lstat, read-only sceKernelOpen): when the last name is not
+    // there but <last name><moduleSuffix> is (a relinked module, which the resolver then returns instead),
+    // nullopt, so the resolver makes that substitution itself.
+    std::optional<std::filesystem::path> Resolve(const std::filesystem::path& root, std::span<const std::string> relative,
+                                                 const std::filesystem::path& absent, std::string_view moduleSuffix = {}) {
+        if (relative.empty()) return std::nullopt;
+        for (const auto& name : relative) if (!Plain(name)) return std::nullopt;
+        std::lock_guard lock(_mutex);
+        auto current = root;
+        for (std::size_t i = 0; i < relative.size(); ++i) {
+            const auto* directory = Listing(current);
+            if (directory == nullptr) return std::nullopt;
+            const auto key = Fold(relative[i]);
+            if (directory->ambiguous.contains(key)) return std::nullopt;
+            const auto found = directory->names.find(key);
+            if (found == directory->names.end()) {
+                if (!moduleSuffix.empty() && i + 1 == relative.size()) {
+                    const auto relinked = key + Fold(moduleSuffix);
+                    if (directory->names.contains(relinked) || directory->ambiguous.contains(relinked)) return std::nullopt;
+                }
+                auto result = absent;
+                for (std::size_t j = i; j < relative.size(); ++j) result /= std::filesystem::path(relative[j]);
+                return result;
+            }
+            current /= found->second.native;
+        }
+        return current;
+    }
+
+    std::size_t Directories() const {
+        std::lock_guard lock(_mutex);
+        return _directories.size();
+    }
+
+private:
+    struct OnDisk {
+        std::filesystem::path native;   // a type of this file's own, so no std instantiation is exported
+    };
+    struct Directory {
+        bool listed = false;
+        std::map<std::string, OnDisk> names;  // folded name -> on-disk name
+        std::set<std::string> ambiguous;
+    };
+
+    const Directory* Listing(const std::filesystem::path& directory) {
+        const auto key = directory.native();
+        if (const auto known = _directories.find(key); known != _directories.end()) return known->second.listed ? &known->second : nullptr;
+        Directory entry;
+        if (auto listed = _lister(directory)) {
+            entry.listed = true;
+            for (auto& [name, native] : *listed) {
+                if (name == "." || name == "..") continue;
+                const auto folded = Fold(name);
+                if (!entry.names.emplace(folded, OnDisk{std::move(native)}).second) entry.ambiguous.insert(folded);
+            }
+        }
+        const auto [stored, inserted] = _directories.emplace(key, std::move(entry));
+        return stored->second.listed ? &stored->second : nullptr;
+    }
+
+    Lister _lister;
+    mutable std::mutex _mutex;
+    std::map<std::filesystem::path::string_type, Directory> _directories;
+};
+
+}  // namespace
+
+#endif
