@@ -194,7 +195,19 @@ bool SameRelinkedStem(std::string_view filename, std::string_view name) {
 }
 
 #ifdef _WIN32
+// Wine matches every path component case-insensitively itself and does not implement
+// FileCaseSensitiveInfo, so under Wine every directory counts as case-insensitive: a name is then
+// matched with one FindFirstFileExW instead of listing the whole directory.
+bool RunningOnWine() {
+    static const bool wine = [] {
+        const auto ntdll = GetModuleHandleW(L"ntdll.dll");
+        return ntdll != nullptr && GetProcAddress(ntdll, "wine_get_version") != nullptr;
+    }();
+    return wine;
+}
+
 bool CaseInsensitiveDirectoryWindows(const std::filesystem::path& directory) {
+    if (RunningOnWine()) return true;
     const auto handle = CreateFileW(directory.c_str(), FILE_READ_ATTRIBUTES,
         FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, nullptr);
     if (handle == INVALID_HANDLE_VALUE) return false;
@@ -400,12 +413,70 @@ std::optional<std::filesystem::path> ProvidedPath(const WorkingDirectory& state,
     if (provided.empty()) return std::nullopt;
     return provided.make_preferred();
 }
+#ifdef _WIN32
+// /app0 under Wine: names answered from one listing per directory (ReadOnlyNameCache.hpp). Off with
+// APS5_NO_APP0_NAME_CACHE, on Windows itself, and when /app0 comes from an app0.zar archive.
+std::optional<std::vector<ReadOnlyNameCache::Entry>> ListDirectoryWindows(const std::filesystem::path& directory) {
+    WIN32_FIND_DATAW data{};
+    auto pattern = directory;
+    pattern /= L"*";
+    const auto handle = FindFirstFileExW(pattern.c_str(), FindExInfoBasic, &data, FindExSearchNameMatch, nullptr, 0);
+    if (handle == INVALID_HANDLE_VALUE) return std::nullopt;
+    const std::unique_ptr<void, decltype(&FindClose)> owner(handle, &FindClose);
+    std::vector<ReadOnlyNameCache::Entry> entries;
+    try {
+        do {
+            const std::filesystem::path name(data.cFileName);
+            entries.push_back({name.string(), name});
+        } while (FindNextFileW(handle, &data));
+    } catch (const std::exception&) {
+        return std::nullopt;   // a name the narrow encoding cannot hold: this directory resolves the usual way
+    }
+    if (GetLastError() != ERROR_NO_MORE_FILES) return std::nullopt;
+    return entries;
+}
+
+// The empty directory missing /app0 names resolve into (Build/RunHybrid/_aps5_absent), or nullopt when
+// the cache is off.
+const std::optional<std::filesystem::path>& App0AbsentDirectory() {
+    static const std::optional<std::filesystem::path> directory = []() -> std::optional<std::filesystem::path> {
+        if (!RunningOnWine() || std::getenv("APS5_NO_APP0_NAME_CACHE") != nullptr) return std::nullopt;
+        auto archive = Directories().root;
+        archive /= L"app0.zar";
+        if (GetFileAttributesW(archive.c_str()) != INVALID_FILE_ATTRIBUTES) return std::nullopt;
+        auto absent = Directories().root;
+        absent /= L"_aps5_absent";
+        if (!CreateDirectoryW(absent.c_str(), nullptr) && GetLastError() != ERROR_ALREADY_EXISTS) return std::nullopt;
+        const auto attributes = GetFileAttributesW(absent.c_str());
+        if (attributes == INVALID_FILE_ATTRIBUTES || (attributes & FILE_ATTRIBUTE_DIRECTORY) == 0) return std::nullopt;
+        return absent;
+    }();
+    return directory;
+}
+
+ReadOnlyNameCache& App0Names() {
+    static auto* cache = new ReadOnlyNameCache(ListDirectoryWindows);
+    return *cache;
+}
+#endif
+
 std::filesystem::path HostPath(WorkingDirectory& state, const std::vector<std::string>& names, bool module = false) {
     if (!module) {
         if (auto overlaid = ResolveOverlay(JoinNames(names))) return *overlaid;
     }
     if (auto aliased = ResolveAlias(JoinNames(names), module)) return *aliased;
     if (auto provided = ProvidedPath(state, names)) return *provided;
+#ifdef _WIN32
+    // Module lookups too (sceKernelStat, lstat and read-only sceKernelOpen resolve as modules): the cache
+    // leaves a missing last name with a relinked module beside it to the resolver.
+    if (!names.empty() && SameName(names.front(), "app0")) {
+        if (const auto& absent = App0AbsentDirectory()) {
+            static const std::string relinked = RelinkedModuleName("").string();  // ".guest.prx"
+            const auto suffix = module ? std::string_view(relinked) : std::string_view();
+            if (auto cached = App0Names().Resolve(state.root, names, *absent, suffix)) return cached->make_preferred();
+        }
+    }
+#endif
     return ResolveHostPath(state.root, names, module).make_preferred();
 }
 void RequireHostDirectory(WorkingDirectory& state, const std::vector<std::string>& names) {
