<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>astrohybrid</AssemblyName>
    <RootNamespace>AstroHybrid.Linux</RootNamespace>
    <Version>1.2.10.1</Version>
    <InformationalVersion>1.2.10-linux.1</InformationalVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1416</NoWarn>

  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../AstroHybrid.Core/AstroHybrid.Core.csproj" />
  </ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="AstroHybrid.Tests" /></ItemGroup>
</Project>
